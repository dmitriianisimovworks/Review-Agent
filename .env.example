APP_NAME=technical-specification-review-agent
APP_ENV=development
HTTP_ADDRESS=:8080
LLM_TIMEOUT_SECONDS=90

LLM_PROVIDER=openai_compatible
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=replace_me
LLM_MODEL=deepseek-chat

DOCUMENT_CHUNK_SIZE=5000
DOCUMENT_MAX_CHUNKS=12

POSTGRES_DB=tsra
POSTGRES_USER=tsra_app
POSTGRES_PASSWORD=replace_me

REDIS_PASSWORD=replace_me

APP_INTERNAL_API_TOKEN=replace_me
APP_ENCRYPTION_KEY=replace_me

DATABASE_URL=postgres://tsra_app:replace_me@postgres:5432/tsra?sslmode=disable
REDIS_URL=redis://:replace_me@redis:6379/0
CACHE_ANALYSIS_TTL_SECONDS=1800

GOOGLE_SERVICE_ACCOUNT_FILE=/root/secrets/google-service-account.json
GOOGLE_OAUTH_CLIENT_ID=replace_me
GOOGLE_OAUTH_CLIENT_SECRET=replace_me
GOOGLE_OAUTH_REDIRECT_URL=https://api.progress-institute.tech/oauth/google/callback
GOOGLE_OAUTH_SCOPES=https://www.googleapis.com/auth/documents,https://www.googleapis.com/auth/drive,https://www.googleapis.com/auth/userinfo.email,https://www.googleapis.com/auth/userinfo.profile
